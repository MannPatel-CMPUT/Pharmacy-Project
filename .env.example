DATABASE_URL=sqlite:///./pharmacy.db
# SQLite only: seconds to wait on a locked DB before failing (default 60). Helps while the large interaction CSV is ingesting in the background.
# SQLITE_LOCK_TIMEOUT=60
# SQLite only: cap CSV ingest commit batch size (default 500) to shorten write locks vs API traffic.
# DDI_CSV_COMMIT_EVERY_SQLITE=500
# Comma-separated browser origins for CORS (include the URL you open in the browser).
FRONTEND_URL=http://localhost:8000,http://localhost:8080

# Secret for PairWise Rx JWT cookies (set in production).
# JWT_SECRET=

# Absolute path to the portal users JSON store. Defaults to fastapi/data/portal_users.json.
# In Docker/production, point this at a persistent volume (e.g. /data/portal_users.json).
# PORTAL_USERS_PATH=

# Absolute path to db_drug_interactions.csv (Drug 1, Drug 2, Interaction Description). Loaded once on startup if not already ingested.
# If unset, the server loads fastapi/data/db_drug_interactions.csv when that file exists (bundled full DDII export).
# DRUG_INTERACTIONS_CSV=/absolute/path/to/db_drug_interactions.csv
# One-time full re-import from that file (deletes existing CSV-backed rows first; slow on huge files — remove after success):
# DDI_CSV_FORCE_RELOAD=1
# Optional: batch size during CSV ingest (default 2000)
# DDI_CSV_COMMIT_EVERY=2000
