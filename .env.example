DATABASE_URL=sqlite:///./pharmacy.db
FRONTEND_URL=http://localhost:8080
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Optional: Ollama HTTP timeout in seconds (default 30)
OLLAMA_TIMEOUT_SECONDS=30

# Optional: openFDA API key (reduces rate-limit issues). See https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
# Optional: openFDA HTTP timeout in seconds (default 30)
OPENFDA_TIMEOUT_SECONDS=30
# Optional: when true (default), medium-confidence SPL co-mentions are stored as DrugInteraction (source=openfda_medium)
OPENFDA_ALLOW_MEDIUM=true
# When true (default), each intake interaction check fetches SPL labels from openFDA for your medication tokens (free API; optional OPENFDA_API_KEY).
OPENFDA_ENRICH_ON_INTAKE=true
# Max unique drug tokens to query per intake (default 6)
OPENFDA_INTAKE_MAX_DRUGS=6
# Labels per search (default 2)
OPENFDA_INTAKE_LABEL_LIMIT=2
# Pause between openFDA calls in seconds (default 0.12) to reduce 429 rate limits
OPENFDA_INTAKE_DELAY_SEC=0.12
